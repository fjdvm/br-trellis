# API OOS Environment Variables Example

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5004;https://localhost:7004

# Database Connection String (SQLite)
ConnectionStrings__DefaultConnection=Data Source=app.db

# JWT Configuration (customer scheme — api-oos's own symmetric-key tokens)
Jwt__Issuer=https://localhost:7004
Jwt__Audience=br-online-shop
Jwt__SecretKey=your-dev-secret-key-min-256-bits-long-for-hmac-sha256
Jwt__ExpirationInMinutes=60

# Staff auth scheme (internal-auth-service OIDC) — validates staff tokens issued
# by the same provider web-crms/api-crms use. Audience validation is disabled
# (matching api-crms); Authority is used for discovery-based signature validation.
StaffAuth__Authority=https://localhost:5001
StaffAuth__Audience=oos-client

# External Service Endpoints
SentraCX__ApiUrl=https://localhost:5005

# api-crms Ecommerce webhook (outbound). BaseUrl is api-crms's origin; the secret
# must match api-crms's Ecommerce:WebhookSecret so HMAC signatures validate.
ApiCrms__BaseUrl=https://localhost:5005
Ecommerce__WebhookSecret=dev-ecommerce-webhook-secret

# CORS & Allowed Hosts
AllowedOrigins__0=http://localhost:3012
AllowedOrigins__1=https://localhost:3012
AllowedOrigins__2=http://localhost:3004
AllowedOrigins__3=https://localhost:3004
AllowedOrigins__4=http://localhost:5005
AllowedHosts=*

# SentraCX chatbot proxy authorization (removed in #126)
CrmSync__ServiceToken=
