# ==============================================================================
# api-crms — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# JWT / Auth (internal-auth-service)
# ------------------------------------------------------------------------------
# Source: internal-auth-service (OpenIddict OIDC provider) at https://localhost:5001
# JWT_AUTHORITY: The OIDC issuer URL (used for token validation via discovery doc)
# JWT_AUDIENCE: The resource identifier — currently unused (ValidateAudience=false)
#   but retained for future audience-scoped token support.
JWT_AUTHORITY=https://localhost:5001
JWT_AUDIENCE=crms-client

# ------------------------------------------------------------------------------
# Brevo SMTP Configuration (Marketing Email Dispatch)
# ------------------------------------------------------------------------------
Brevo__SmtpHost=smtp-relay.brevo.com
Brevo__SmtpPort=587
Brevo__Username=your-brevo-smtp-username
Brevo__Password=your-brevo-smtp-password
Brevo__FromEmail=marketing@example.com
Brevo__FromName=Bren Raphael's
